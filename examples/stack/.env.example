# Independent project configuration. Real values belong in ignored .env only.
# independent = four projects; two-project-demo = two explicit shared resource groups.
SUPABASE_LAYOUT=independent
API_TOKEN=
SANDBOX_SERVICE_TOKEN=
MODEL_SERVICE_TOKEN=
AUTOMATION_SERVICE_TOKEN=
DOCKER_GID=
BIND_ADDRESS=127.0.0.1
WEB_PORT=8098
ARTIFACT_MODE=supabase
SPRING_PROFILES_ACTIVE=

# SANDBOX: dedicated database and project URL.
SANDBOX_DATABASE_URL=jdbc:postgresql://YOUR_SANDBOX_DB_HOST:5432/postgres?sslmode=require
SANDBOX_DATABASE_USER=
SANDBOX_DATABASE_PASSWORD=
SANDBOX_SUPABASE_URL=https://YOUR_SANDBOX_PROJECT.supabase.co
SANDBOX_SUPABASE_SERVICE_ROLE_KEY=

# MODEL: dedicated database and project URL.
MODEL_DATABASE_URL=jdbc:postgresql://YOUR_MODEL_DB_HOST:5432/postgres?sslmode=require
MODEL_DATABASE_USER=
MODEL_DATABASE_PASSWORD=
MODEL_SUPABASE_URL=https://YOUR_MODEL_PROJECT.supabase.co

# AUTOMATION: dedicated database and project URL.
AUTOMATION_DATABASE_URL=jdbc:postgresql://YOUR_AUTOMATION_DB_HOST:5432/postgres?sslmode=require
AUTOMATION_DATABASE_USER=
AUTOMATION_DATABASE_PASSWORD=
AUTOMATION_SUPABASE_URL=https://YOUR_AUTOMATION_PROJECT.supabase.co
AUTOMATION_SUPABASE_SERVICE_ROLE_KEY=

# AI-SDLC: independent Workspace/Auth project. No Java service receives its service-role key.
AI_SDLC_SUPABASE_URL=https://YOUR_AI_SDLC_PROJECT.supabase.co
AI_SDLC_SUPABASE_ANON_KEY=
# Shared login identity is allowed; data and privileged project credentials remain separate.
AI_SDLC_JWT_ISSUER=
AI_SDLC_JWKS_URL=

# Model provider settings are unrelated to the Model Gateway Supabase project.
MODEL_MODE=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=demo-model
GIT_REPOSITORIES_JSON={}

# rpc is deployable through SQL; edge requires deploying the optional function.
AI_SDLC_WORKSPACE_TRANSPORT=rpc
